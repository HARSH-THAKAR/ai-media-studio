# Local machine configuration
config/settings.toml

# Credentials, which must never reach a public repository
.env
.env.*
*.pem
*.key
*.pfx
*.p12
secrets.toml
credentials.json
service-account*.json

# Generated artifacts
output/
temp/
cache/
logs/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/

# Vendored third-party runtimes and model weights (installed locally, not source)
comfyui/
model/
voice/
ffmpeg-*/

# Stray nested repository
AI-Media-Studio/

# Local tool settings
.claude/settings.local.json

# Local media assets
assets/*
!assets/.gitkeep
# Demo material shown in the README is committed, unlike local scratch assets.
!assets/demo/
!assets/demo/**
music/*
!music/.gitkeep

{
  "1": {
    "class_type": "ImageOnlyCheckpointLoader",
    "inputs": {
      "ckpt_name": "svd_xt.safetensors"
    },
    "_meta": {
      "title": "Load Video Model"
    }
  },
  "2": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "",
      "upload": "image"
    },
    "_meta": {
      "title": "Scene Image"
    }
  },
  "3": {
    "class_type": "SVD_img2vid_Conditioning",
    "inputs": {
      "clip_vision": ["1", 1],
      "init_image": ["2", 0],
      "vae": ["1", 2],
      "width": 576,
      "height": 1024,
      "video_frames": 25,
      "motion_bucket_id": 127,
      "fps": 6,
      "augmentation_level": 0.0
    },
    "_meta": {
      "title": "SVD Conditioning"
    }
  },
  "4": {
    "class_type": "VideoLinearCFGGuidance",
    "inputs": {
      "model": ["1", 0],
      "min_cfg": 1.0
    },
    "_meta": {
      "title": "Video Guidance"
    }
  },
  "5": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0,
      "steps": 20,
      "cfg": 2.5,
      "sampler_name": "euler",
      "scheduler": "karras",
      "denoise": 1.0,
      "model": ["4", 0],
      "positive": ["3", 0],
      "negative": ["3", 1],
      "latent_image": ["3", 2]
    },
    "_meta": {
      "title": "KSampler"
    }
  },
  "6": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["5", 0],
      "vae": ["1", 2]
    },
    "_meta": {
      "title": "VAE Decode"
    }
  },
  "7": {
    "class_type": "SaveWEBM",
    "inputs": {
      "images": ["6", 0],
      "filename_prefix": "ai_media_studio_clip",
      "codec": "vp9",
      "fps": 6.0,
      "crf": 28.0
    },
    "_meta": {
      "title": "Save Clip"
    }
  }
}
